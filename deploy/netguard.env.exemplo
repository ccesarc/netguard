# Copie para ~/.config/netguard/netguard.env (chmod 600).
# O systemd não expande ~: use caminhos absolutos.

# Endereço e porta. 0.0.0.0 = aceita da rede de casa (o serviço recusa IP de fora
# das redes privadas mesmo assim). Para só esta máquina: 127.0.0.1:8095
NETGUARD_ENDERECO=0.0.0.0:8095

# Arquivo com a URL do banco (preferido: a senha não fica no ambiente).
NETGUARD_BANCO_URL_ARQUIVO=/home/USUARIO/.config/netguard/banco_url

# Interface a vigiar. Vazio = a da rota padrão.
NETGUARD_INTERFACE=

# Intervalo entre verificações (2s a 10m).
NETGUARD_INTERVALO=10s

# debug, info, warn ou error
NETGUARD_LOG=info

# Redes aceitas (CIDR separados por vírgula). Vazio = redes privadas.
# NETGUARD_REDES=10.0.0.0/24,127.0.0.0/8

# true só quando houver HTTPS na frente.
NETGUARD_COOKIE_SEGURO=false
